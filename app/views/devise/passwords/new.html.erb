<% content_for :title, "パスワード再設定" %>

<section class="mx-auto max-w-md px-5 py-16">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900">パスワード再設定</h1>
  <p class="mt-2 text-sm text-slate-600">登録したメールアドレスを入力してください。再設定用の案内を送ります。</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: auth_label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: auth_field_class %>
    </div>

    <div>
      <%= f.submit "再設定案内を送る", class: auth_submit_class %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
