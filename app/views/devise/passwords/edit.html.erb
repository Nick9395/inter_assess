<% content_for :title, "新しいパスワード" %>

<section class="mx-auto max-w-md px-5 py-16">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900">新しいパスワード</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "新しいパスワード", class: auth_label_class %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-slate-500"><%= @minimum_password_length %>文字以上</p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: auth_field_class %>
    </div>

    <div>
      <%= f.label :password_confirmation, "新しいパスワード（確認）", class: auth_label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: auth_field_class %>
    </div>

    <div>
      <%= f.submit "パスワードを更新する", class: auth_submit_class %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
