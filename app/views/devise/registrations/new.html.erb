<% content_for :title, "利用開始" %>

<section class="mx-auto max-w-md px-5 py-16">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900">利用開始</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :username, class: auth_label_class %>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", class: auth_field_class %>
    </div>

    <div>
      <%= f.label :email, class: auth_label_class %>
      <%= f.email_field :email, autocomplete: "email", class: auth_field_class %>
    </div>

    <div>
      <%= f.label :password, class: auth_label_class %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-slate-500"><%= @minimum_password_length %>文字以上</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: auth_field_class %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: auth_label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: auth_field_class %>
    </div>

    <div>
      <%= f.submit "登録する", class: auth_submit_class %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
