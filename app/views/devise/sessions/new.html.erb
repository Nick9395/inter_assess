<% content_for :title, "ログイン" %>

<section class="mx-auto max-w-md px-5 py-16">
  <h1 class="text-2xl font-semibold tracking-tight text-slate-900">ログイン</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f| %>
    <div>
      <%= f.label :email, class: auth_label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: auth_field_class %>
    </div>

    <div>
      <%= f.label :password, class: auth_label_class %>
      <%= f.password_field :password, autocomplete: "current-password", class: auth_field_class %>
    </div>

    <div>
      <%= f.submit "ログイン", class: auth_submit_class %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
